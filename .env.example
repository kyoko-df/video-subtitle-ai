# Set these variables in your shell before starting Shengmu. This file is not auto-loaded.
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway; it must implement whisper-1 verbose_json segments.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional LM Studio local subtitle translation (no OpenAI dependency or key required).
# Install LM Studio, download/load a text model, and start its Developer server first.
# Only loopback HTTP addresses are accepted. The default port is 1234.
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Only needed if authentication is enabled in LM Studio.
# LM_STUDIO_API_KEY=
# Optional model cache location / pre-downloaded model directory via --model.
# SHENGMU_MODEL_DIR=/path/to/model-cache
# Optional custom executable locations.
# FFMPEG_BINARY=/path/to/ffmpeg
# FFPROBE_BINARY=/path/to/ffprobe

# GUI projects survive restart in this directory (default: .shengmu/workspace).
# SHENGMU_WORKSPACE=/path/to/projects
# Optional local speaker diarization (install .[diarization], accept Community-1 terms).
# HF_TOKEN=
# SHENGMU_DIARIZATION_MODEL=/path/to/community-1
